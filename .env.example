# Required for live agent calls.
TOGETHER_API_KEY=your_together_api_key_here

# Optional runtime overrides.
# MINI_AEC_PROJECT_ROOT=/absolute/path/to/mini-aec-agent
MINI_AEC_MODEL=Qwen/Qwen3.5-9B
MINI_AEC_TEMPERATURE=0
MINI_AEC_SEED=42
MINI_AEC_MAX_AGENT_STEPS=8
MINI_AEC_MAX_OUTPUT_TOKENS=1024
MINI_AEC_MODEL_TIMEOUT_SECONDS=60
MINI_AEC_RETRY_DELAYS=1,2,4
MINI_AEC_LOG_LEVEL=INFO
MINI_AEC_LOG_FORMAT=text
MINI_AEC_API_HOST=127.0.0.1
MINI_AEC_API_PORT=8000
# Optional. When set, every /v1 endpoint requires an X-API-Key header.
# MINI_AEC_SERVICE_API_KEY=replace_with_a_long_random_value
# Explicit escape hatch for an isolated network only. Keep false otherwise.
MINI_AEC_ALLOW_INSECURE_PUBLIC_BIND=false
MINI_AEC_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=mini-aec-compliance-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional path to a real IFC model.
# MINI_AEC_IFC_FILE=examples/sample_office.ifc
# MINI_AEC_IFC_RULES_FILE=data/rules/bfa_2025_accessibility.json

# Optional regulation ingestion and retrieval paths.
# MINI_AEC_REGULATION_PDF=regulations/bfa_2008_2025.pdf
# MINI_AEC_REGULATION_INDEX=data/processed/regulation_chunks.json
